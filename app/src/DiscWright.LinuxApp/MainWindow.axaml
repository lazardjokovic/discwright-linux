<!--
    The main window, on Linux.

    It holds no decisions. Every question it asks is answered by MakeADisc,
    the same screen the Windows window asks, so what is here is only
    arrangement: where things sit, what they are called, and which of them is
    bound to what. It is MainWindow.xaml in the Windows app said the way
    Avalonia says it, a part at a time, and what is not here yet is not on the
    window yet.

    Drawn at 920 by 740 and resizable in height only. The games list lines its
    sizes up at a fixed width (AThingOnTheDisc.HowWideTheNameIs), so narrower
    cut the sizes off and wider left them stranded in the middle of the list.
    The width is held at what was drawn.

    Everything an automated test touches carries an AutomationId, set here and
    never left to the framework to invent, and by the same names as the
    Windows window.

    A binding here is checked when it is compiled, against MakeADisc, so a
    property renamed in the shared code stops this build.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:screen="using:DiscWright.ViewModels"
        xmlns:core="using:DiscWright.Core"
        x:Class="DiscWright.LinuxApp.MainWindow"
        x:DataType="screen:MakeADisc"
        Title="DiscWright"
        Icon="/DiscWright.ico"
        Width="920" Height="740"
        MinHeight="560" MinWidth="920" MaxWidth="920"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="TheWindow">

    <Grid Margin="28,16,28,18" RowDefinitions="Auto,*,Auto">

        <!-- ================================================== the top line -->
        <!-- A rule under it, so the space to the right of the name reads as a
             header bar rather than as somewhere a thing used to be. -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="0,0,0,10"
                BorderBrush="{DynamicResource Edge}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,28,340">

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- The name, and which build it is. The version beside
                         the name, not under it: on its own underneath, "2.0.0"
                         could as easily have been about the disc being made. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DiscWright" Classes="Title" />

                        <TextBlock Classes="Aside"
                                   Margin="8,0,0,4"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding ThisBuild}"
                                   AutomationProperties.AutomationId="ThisBuild" />
                    </StackPanel>

                    <!-- THE PROGRAM'S OWN LINKS, ON ONE LINE. Stacked one under
                         another they made this corner four rows tall beside a
                         column of buttons two rows tall. Side by side with a
                         dot between, the way the totals bar under the list
                         reads. A WrapPanel, so a long line wraps rather than
                         running under the buttons.

                         The link that asks whether there is a newer version
                         is not here yet. On Windows it is first on this line.
                         It asks about the Windows app's releases, and what a
                         Linux DiscWright's version is has not been decided. -->
                    <WrapPanel Margin="0,4,0,0">
                        <!-- About the program, not about the disc being made.
                             One quiet control cycling three answers rather than
                             a dropdown, because it is touched once. Its words
                             come from ChoosingTheLook, whose DataContext the
                             window sets, so the screen stays ignorant of
                             themes. -->
                        <Button x:Name="HowItDresses"
                                x:DataType="screen:ChoosingTheLook"
                                Content="{Binding InWords}"
                                Theme="{StaticResource Quietly}"
                                Click="ChooseTheNextLook"
                                ToolTip.Tip="Light, dark, or whatever the desktop wears. Following the desktop is the default."
                                AutomationProperties.AutomationId="Appearance" />

                        <TextBlock Text="·" Classes="Aside" Margin="7,0" VerticalAlignment="Center" />

                        <!-- Asked for by the owner on 2026-11-10 after a night
                             of rebuilding a failed set from screenshots. Opens
                             today's file in whatever opens text, or the folder
                             when today has nothing in it yet. -->
                        <Button Content="Open the log"
                                Theme="{StaticResource Quietly}"
                                Click="OpenTheLog"
                                ToolTip.Tip="What DiscWright did and what the drives said, one file a day. It stays on this machine."
                                AutomationProperties.AutomationId="OpenTheLog" />
                    </WrapPanel>
                </StackPanel>

                <!-- About the whole window rather than about one more game, which
                     is why it sits up here and not beside Add a game. -->
                <!-- Side by side rather than stacked. Two of these one above the
                     other was eighty pixels of button beside sixty of title, and
                     the whole top of the window was the taller of them. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Content="Start a new disc"
                                IsEnabled="{Binding CanStartAgain}"
                                Theme="{StaticResource Ordinary}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,5,0"
                                Click="StartANewDisc"
                                AutomationProperties.AutomationId="StartANewDisc" />

                        <Button Grid.Column="1"
                                Content="Open one you built"
                                IsEnabled="{Binding NothingIsRunning}"
                                Theme="{StaticResource Ordinary}"
                                HorizontalAlignment="Stretch"
                                Margin="5,0,0,0"
                                Click="OpenADisc"
                                AutomationProperties.AutomationId="OpenADisc" />
                    </Grid>

                    <!-- The quiet third of the pair above. Saving writes the
                         same discproject.json a build leaves behind, into the
                         folder the discs go in, so Open one you built finds it
                         the same way. Quiet rather than a third box because
                         the row above is already as wide as its column, and
                         because saving is the small act next to the two big
                         ones. -->
                    <Button Content="Save it for later, without building"
                            Theme="{StaticResource Quietly}"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0"
                            IsEnabled="{Binding CanSaveItForLater}"
                            ToolTip.Tip="Writes discproject.json into the folder under WHERE TO SAVE THE ISO. Open one you built brings it back."
                            Click="SaveItForLater"
                            AutomationProperties.AutomationId="SaveItForLater" />

                    <!-- Where it went, left where it can be read again, the
                         same manners as the line about the last burn. -->
                    <TextBlock Classes="Aside"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Right"
                               Text="{Binding HowTheSaveWent}"
                               IsVisible="{Binding HowTheSaveWent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="HowTheSaveWent" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================== the middle -->
        <Grid Grid.Row="1" ColumnDefinitions="*,28,340">

            <!-- What goes on it -->
            <DockPanel Grid.Column="0">
                <!-- Alone on its row, like WHAT IT IS CALLED across the way. -->
                <TextBlock DockPanel.Dock="Top"
                           Classes="Step"
                           Text="WHAT GOES ON IT" />

                <!-- Said under the tree rather than beside a row, because
                     it is about the disc and not about one file. -->
                <!-- What the recogniser noticed about the folder a game came
                     out of. An unfinished download is the one that matters:
                     it builds an ISO that looks perfect and fails when the
                     installer is run off the burned disc.

                     Here rather than in a box when the game is added, because
                     a box is dismissed and the burn is an hour later. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WorryInk}"
                           Text="{Binding WhatTheDownloadsSay}"
                           IsVisible="{Binding WhatTheDownloadsSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.AutomationId="WhatTheDownloadsSay" />

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WorryInk}"
                           Text="{Binding APatchWithNothingToPatch}"
                           IsVisible="{Binding APatchWithNothingToPatch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.AutomationId="APatchWithNothingToPatch" />

                <!-- Two rows reading alike here are two menu buttons reading
                     alike on the burned disc. A notice and never a refusal:
                     two editions of one game are an ordinary thing to burn,
                     and what was asked for (discwright#98) was being told,
                     not being stopped. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WorryInk}"
                           Text="{Binding WhoWearsTheSameName}"
                           IsVisible="{Binding WhoWearsTheSameName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.AutomationId="WhoWearsTheSameName" />

                <!-- What the opened project named that is no longer where it
                     left it, discwright#98. The games that did not come back
                     cannot be rows, so this line is their only trace. It used
                     to be a box, and a box is gone at OK while the games are
                     still gone an hour later. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WorryInk}"
                           Text="{Binding WhatDidNotComeBack}"
                           IsVisible="{Binding WhatDidNotComeBack, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.AutomationId="WhatDidNotComeBack" />

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WorryInk}"
                           Text="{Binding WhyThatMatters}"
                           IsVisible="{Binding WhyThatMatters, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.AutomationId="WhyThatMatters" />

                <!-- A disc that copies a folder rather than starting it is a
                     thing somebody may well mean to make, so this is ordinary
                     ink beside the amber. What it is not is something to find
                     out by burning the disc and pressing the button. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Classes="Aside"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding WhatWillNotStartItself}"
                           IsVisible="{Binding WhatWillNotStartItself, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.AutomationId="WhatWillNotStartItself" />

                <!-- Above the list, not under it. These act on the list, so
                     they stay inside this panel's column rather than joining
                     the project pair top right, but under the list they were
                     the last thing in reading order and the first thing a
                     new window needs: on an empty window the one thing to do
                     sat below a large blank box. Above the panel rather than
                     inside it, because a button inside is covered by the
                     tree and cannot be pressed. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Add a game"
                                IsEnabled="{Binding NothingIsRunning}"
                                Theme="{StaticResource Ordinary}"
                                Click="AddAGame"
                                AutomationProperties.AutomationId="AddAGame" />
                    </StackPanel>

                    <!-- Dead here, always, and it says why. On Windows this
                         opens the disc's own menu, in the thing that will
                         open it on the disc, which is the whole point of it:
                         a second drawing of the menu that only looked
                         similar would be a preview that drifts from the
                         disc. The menu is a Windows page, and nothing on a
                         Linux desktop draws one.

                         There and dead rather than left off, so that
                         somebody who knows the Windows app does not go
                         looking for it, and so that what a disc will carry
                         is not a surprise. The owner's decision on
                         2026-11-15. The reason shows on hover, which a dead
                         button does not do unless it is told to. -->
                    <Button Grid.Column="1"
                            Content="See what it will look like"
                            Theme="{StaticResource Ordinary}"
                            HorizontalAlignment="Right"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            ToolTip.ShowOnDisabled="True"
                            ToolTip.Tip="The menu is a Windows page, and nothing on Linux can show one, so there is no looking at it here. It goes on the disc all the same, and opens on Windows."
                            AutomationProperties.AutomationId="PreviewTheMenu" />
                </Grid>

                <Border Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Edge}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <!-- The list, and a line under it that adds the list up.
                         Two rows rather than one, so the total sits inside
                         the panel it is about rather than floating under it
                         among the lines about what was left off. -->
                    <Grid RowDefinitions="*,Auto">

                        <!-- Said once, on an empty list, and gone the moment
                             there is anything to show. The words and nothing
                             else: a button beside them sat under the tree on
                             Windows and could not be pressed. -->
                        <TextBlock Classes="Aside"
                                   VerticalAlignment="Top"
                                   Margin="16,16,16,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !Games.Count}"
                                   AutomationProperties.AutomationId="NothingYet"
                                   Text="Nothing yet. Add the folder a game was downloaded into, or the folder it is installed in. Dropping one here works too, the installer's own exe included." />

                        <!-- A tree, because a game is not one thing.
                             It is an installer, its parts, whatever folders
                             came with it and the patches that were taken on
                             beside it, and the only way to leave one of those
                             off used to be to not add the game at all.

                             Every row carries a tick. Everything under a row
                             follows it, and a row follows what is under it, so
                             a folder with some of its files left out shows
                             neither on nor off rather than lying about what
                             will be written. -->
                        <TreeView x:Name="Games"
                                  SelectionChanged="WhatIsPickedChanged"
                                  KeyDown="TheListKeys"
                                  ItemsSource="{Binding WhatGoesOnIt}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="4"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding NothingIsRunning}"
                                  AutomationProperties.AutomationId="Games">
                            <!-- Without this a row answers to whatever the
                                 thing in it prints as. A reader would say all
                                 of it aloud, and a window test would see it
                                 instead of a name. -->
                            <TreeView.ItemContainerTheme>
                                <!-- On top of the row's own look, not instead
                                     of it. -->
                                <ControlTheme TargetType="TreeViewItem"
                                              BasedOn="{StaticResource {x:Type TreeViewItem}}"
                                              x:DataType="screen:AThingOnTheDisc">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />

                                    <!-- A game is open and the folders inside
                                         it are shut, which is the row's own
                                         IsOpened default. The state lives on
                                         the row rather than here, because
                                         taking a row off rebuilds its branch,
                                         and open state the window kept alone
                                         died with the old rows. Two way, so
                                         what somebody opens by hand reaches
                                         the row and survives the rebuild. -->
                                    <Setter Property="IsExpanded" Value="{Binding IsOpened, Mode=TwoWay}" />
                                </ControlTheme>
                            </TreeView.ItemContainerTheme>

                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Inside}" x:DataType="screen:AThingOnTheDisc">
                                    <!-- Laid out left to right with the name
                                         given a width, rather than a grid
                                         with a column pushed to the right.
                                         Bounding the name is what keeps a
                                         row inside the panel whatever is in
                                         it, and what puts every size in one
                                         column. -->
                                    <StackPanel Classes="ARow"
                                                Orientation="Horizontal"
                                                Margin="0,3"
                                                Background="Transparent">
                                        <CheckBox VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  IsThreeState="{Binding HasThingsInside}"
                                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name}" />

                                        <!-- Narrowed by however far the tree has
                                             already pushed this row in, which
                                             is what puts every size in one
                                             column. Worked out by the row
                                             rather than here, where a number
                                             is a number no test can ask
                                             about. -->
                                        <TextBlock Width="{Binding HowWideTheNameIs}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding !IsBeingRenamed}"
                                                   AutomationProperties.HelpText="{Binding InFull}"
                                                   ToolTip.Tip="{Binding InFull}" />

                                        <!-- The name again, open for typing,
                                             only while the row is being
                                             renamed. Its text is set as it
                                             appears and read as it closes, in
                                             the code behind, so a rename
                                             abandoned with Escape leaves no
                                             stale text for next time. Its
                                             width too: it stands in for the
                                             name and only ever instead of
                                             it. -->
                                        <TextBox VerticalAlignment="Center"
                                                 Padding="4,2"
                                                 IsVisible="{Binding IsBeingRenamed}"
                                                 KeyDown="TheRenameKeys"
                                                 LostFocus="TheRenameBoxLostItsFocus"
                                                 AutomationProperties.AutomationId="RenameBox" />

                                        <!-- The installer and a patch are
                                             worth naming. An ordinary file is
                                             not, and this is empty for one. -->
                                        <!-- One of the game's own says what
                                             it is as a link, and a press
                                             makes the manual an extra or the
                                             extra the manual, so one put in
                                             the wrong place is one press from
                                             the right one. -->
                                        <Panel Width="70" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Classes="Aside"
                                                       TextWrapping="NoWrap"
                                                       Text="{Binding What}"
                                                       IsVisible="{Binding !CanBeEither}" />
                                            <Button Theme="{StaticResource AsALink}"
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding What}"
                                                    ToolTip.Tip="{Binding WhatItCouldBe}"
                                                    AutomationProperties.HelpText="{Binding WhatItCouldBe}"
                                                    IsVisible="{Binding CanBeEither}"
                                                    Click="SwapWhatItIs"
                                                    AutomationProperties.AutomationId="SwapWhatItIs" />
                                        </Panel>

                                        <!-- Up against its own right edge, so
                                             the figures end under each other
                                             and the column can be read down. -->
                                        <TextBlock Classes="Aside"
                                                   Width="76"
                                                   TextAlignment="Right"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,2,0"
                                                   Text="{Binding HowBig}" />

                                        <!-- The row's own way off the list,
                                             shown while the row is under the
                                             pointer and unseen rather than
                                             gone otherwise, so the columns
                                             stand still. The tick stays what
                                             it always was, on this disc or
                                             off it; the cross is off the
                                             list. -->
                                        <Button Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="OffTheRow"
                                                Theme="{StaticResource OffTheRow}"
                                                Click="TakeOffThisRow"
                                                ToolTip.Tip="Take it off the list"
                                                AutomationProperties.Name="Take it off the list"
                                                AutomationProperties.AutomationId="TakeOffThisRow" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- What the whole list comes to.
                             Every row shows its own size and a game shows the
                             sum of what is under it, and there was nowhere at
                             all that said what the lot came to.

                             It follows the ticks, because what is going on
                             the disc is what is ticked. -->
                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource Edge}"
                                BorderThickness="0,1,0,0"
                                Padding="10,6"
                                IsVisible="{Binding !!Games.Count}"
                                AutomationProperties.AutomationId="TheTotals">
                            <StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Classes="Aside"
                                           Text="{Binding WhatIsOnIt}"
                                           AutomationProperties.AutomationId="WhatIsOnIt" />

                                <!-- Only between the two sentences, never
                                     leading the line: with everything
                                     unticked the total says nothing at all,
                                     and a separator with nothing on its left
                                     is a smudge. -->
                                <TextBlock Classes="Aside"
                                           Text="·"
                                           Margin="6,0"
                                           AutomationProperties.AutomationId="BetweenTheTwo">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="WhatIsOnIt" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                            <Binding Path="WhatIsLeftOff" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>

                                <TextBlock Classes="Aside"
                                           Text="{Binding WhatIsLeftOff}"
                                           IsVisible="{Binding WhatIsLeftOff, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           AutomationProperties.AutomationId="WhatIsLeftOff" />

                                <!-- The sentence's own remedy, in link ink
                                     rather than the quiet grey because grey
                                     in this corner is what was being missed.
                                     It carries no count of its own, the count
                                     is an inch to the left. -->
                                <Button Content="{Binding WhatTakingTheLeftOffOnesSays}"
                                        Theme="{StaticResource AsALink}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding NothingIsRunning}"
                                        IsVisible="{Binding WhatTakingTheLeftOffOnesSays, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Click="TakeOffWhatIsLeftOff"
                                        AutomationProperties.AutomationId="TakeOffWhatIsLeftOff" />
                            </WrapPanel>

                            <!-- The picked game's own manual and extras, for
                                 goodies kept apart from the installer. Only
                                 while a game is picked, and named, so it is
                                 plain which game they go to. -->
                            <WrapPanel Orientation="Horizontal"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding ThePickedGame, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.AutomationId="ForThePickedGame">
                                <TextBlock Classes="Aside"
                                           Text="{Binding ThePickedGame, StringFormat={}{0}:}"
                                           AutomationProperties.AutomationId="ThePickedGame" />
                                <Button Content="Add a manual"
                                        Theme="{StaticResource AsALink}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding NothingIsRunning}"
                                        Click="AddAManualToThePickedGame"
                                        AutomationProperties.AutomationId="AddAManual" />
                                <TextBlock Classes="Aside" Text="·" Margin="6,0" />
                                <Button Content="Add extras"
                                        Theme="{StaticResource AsALink}"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding NothingIsRunning}"
                                        Click="AddExtrasToThePickedGame"
                                        AutomationProperties.AutomationId="AddExtras" />
                            </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- What it is called, and where it goes.

                 In a scroller because this column has twice grown past the
                 bottom of a window drawn for what was in it before, and both
                 times the answer was a taller window. A scrollbar appears only
                 when it is needed and nothing can be lost again.

                 Not here yet, and in the Windows window: which drive, and
                 what is in it. One thing in the Windows window is never
                 coming: "Readable by
                 Windows 98 and Mac OS 9". A disc made here is laid out the
                 older way to begin with, so it is not a choice. -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Classes="Step" Text="WHAT IT IS CALLED" />
                    <TextBox x:Name="TheName"
                             Text="{Binding Label}"
                             MaxLength="32"
                             TextChanged="KeepTheNameInCapitals"
                             IsEnabled="{Binding NothingIsRunning}"
                             AutomationProperties.AutomationId="Label" />
                    <!-- About the disc, which goes into a Windows machine,
                         so This PC is right here whatever built it. -->
                    <TextBlock Classes="Aside"
                               Margin="0,5,0,0"
                               Text="What This PC shows when the disc goes in." />

                    <TextBlock Classes="Step" Margin="0,16,0,6" Text="WHAT SIZE OF DISC" />
                    <ComboBox ItemsSource="{Binding DiscSizes}"
                              SelectedItem="{Binding TheSizeChosen}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding NothingIsRunning}"
                              AutomationProperties.AutomationId="DiscSize">
                        <!-- A row answers to the words it shows, and not to
                             whatever the thing in it prints as. -->
                        <ComboBox.ItemContainerTheme>
                            <ControlTheme TargetType="ComboBoxItem"
                                          BasedOn="{StaticResource {x:Type ComboBoxItem}}"
                                          x:DataType="core:ASizeToAimAt">
                                <Setter Property="AutomationProperties.Name" Value="{Binding InWords}" />
                            </ControlTheme>
                        </ComboBox.ItemContainerTheme>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ASizeToAimAt">
                                <TextBlock Text="{Binding InWords}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Beside the size, because it is the answer to "that will
                         not fit". In More options it was a setting somebody had
                         to already know about to go looking for. -->
                    <CheckBox Margin="0,8,0,0"
                              Content="Split a file too big for one disc"
                              IsChecked="{Binding CutFiles}"
                              IsEnabled="{Binding NothingIsRunning}"
                              AutomationProperties.AutomationId="CutFiles" />

                    <!-- What it will actually do, with these files and this
                         size of disc, rather than a number written into a
                         label. It also says "Needs 2 discs" whenever the size
                         chosen means more than one, with the box ticked or
                         not. -->
                    <TextBlock Classes="Aside"
                               Margin="22,2,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding WhatSplittingWouldDo}"
                               IsVisible="{Binding WhatSplittingWouldDo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="WhatSplittingWouldDo" />

                    <!-- Named for what lands there. "WHERE IT GOES" read as if
                         it were about the disc, which is the one thing this
                         folder never holds. -->
                    <TextBlock Classes="Step" Margin="0,16,0,6" Text="WHERE TO SAVE THE ISO" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding OutputFolder}"
                                 ToolTip.Tip="The disc is built into a folder here, with its ISO beside it."
                                 IsEnabled="{Binding NothingIsRunning}"
                                 AutomationProperties.AutomationId="OutputFolder" />
                        <Button Grid.Column="1"
                                Content="Browse"
                                IsEnabled="{Binding NothingIsRunning}"
                                Theme="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ChooseWhereItGoes"
                                AutomationProperties.AutomationId="ChooseWhereItGoes" />
                    </Grid>

                    <!-- A window of its own. There are seven of these, most
                         of them pictures, and a picture somebody chose is
                         only really confirmed by seeing it again. -->
                    <Button Content="Artwork, music and extras"
                            IsEnabled="{Binding NothingIsRunning}"
                            Theme="{StaticResource Ordinary}"
                            HorizontalAlignment="Stretch"
                            Margin="0,18,0,0"
                            Click="WhatElseGoesOnIt"
                            AutomationProperties.AutomationId="OpenWhatElseGoesOnIt" />

                    <TextBlock Classes="Aside"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding WhatElseIsChosen}"
                               AutomationProperties.AutomationId="WhatElseIsChosen" />

                    <Expander Margin="0,16,0,0"
                              Foreground="{DynamicResource Quiet}"
                              FontSize="12"
                              Header="More options"
                              AutomationProperties.AutomationId="MoreOptions">
                        <StackPanel Margin="4,10,0,0">
                            <!-- On by default, and the only option here whose
                                 effect depends on a setting that is not ours.
                                 The hover says so, because a disc that does
                                 nothing when it goes in looks broken, and the
                                 reason is on the other person's machine. -->
                            <CheckBox Content="A menu that opens when the disc goes in"
                                      IsChecked="{Binding Menu}"
                                      IsEnabled="{Binding NothingIsRunning}"
                                      AutomationProperties.AutomationId="Menu">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                               Text="A disc opens its menu by itself only where AutoRun is switched on, and Windows has been turning that off for years. Where it is off, the disc opens in Explorer instead and the menu is the AUTORUN folder." />
                                </ToolTip.Tip>
                            </CheckBox>

                            <!-- Straight after the menu's box, because it
                                 belongs to it: a Start Here file opens the
                                 menu, so with no menu there is nothing for it
                                 to open and it is dead. Lined up with the
                                 others rather than stepped in. -->
                            <CheckBox Content="A Start Here file at the top of the disc"
                                      IsChecked="{Binding StartHere}"
                                      AutomationProperties.AutomationId="StartHere">
                                <CheckBox.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="NothingIsRunning" />
                                        <Binding Path="Menu" />
                                    </MultiBinding>
                                </CheckBox.IsEnabled>
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                               Text="Start Here.hta opens the menu by hand on a computer where AutoRun is off, which is most of them now. Without it the menu is still on the disc, in the AUTORUN folder." />
                                </ToolTip.Tip>
                            </CheckBox>

                            <!-- Said, because it was asked: xniwo ticked it off
                                 on 2.0.1 and found nothing missing,
                                 discwright#98. Only the list is, and the check
                                 that reads it. -->
                            <CheckBox Content="A list of what every file should be"
                                      IsChecked="{Binding Checksums}"
                                      IsEnabled="{Binding NothingIsRunning}"
                                      AutomationProperties.AutomationId="Checksums">
                                <ToolTip.Tip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="360"
                                               Text="Puts checksums.sha256 at the top of the disc, a fingerprint of every file on it. The tick beside the music button in the disc's menu checks the disc against it, and so can sha256sum anywhere, years from now. Left off, everything else on the disc is the same; only that check is gone." />
                                </ToolTip.Tip>
                            </CheckBox>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================ the bottom line

             What it will make, anything worth saying about it, and the one
             button. The refusal lives here rather than in a dialog, because a
             refusal somebody reads before pressing anything is a sentence, and
             the same refusal after a click is a wasted decision.
        -->
        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="18,14"
                Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Edge}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding WhatItWillMake}"
                               IsVisible="{Binding !IsWorking}"
                               AutomationProperties.AutomationId="WhatItWillMake" />

                    <!-- While it runs, the same line says what it is doing,
                         because that is the only thing anybody wants from it
                         then. -->
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Doing}"
                               IsVisible="{Binding IsWorking}"
                               AutomationProperties.AutomationId="Doing" />

                    <ProgressBar Height="14"
                                 Margin="0,10,0,0"
                                 Maximum="1"
                                 Value="{Binding HowFar, Mode=OneWay}"
                                 IsVisible="{Binding IsWorking}"
                                 AutomationProperties.AutomationId="HowFar" />

                    <!-- What the button actually means. On Windows this line
                         tells building from burning. This DiscWright does not
                         burn yet, so it says that, and what will. -->
                    <TextBlock Classes="Aside"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Building puts the disc and its ISO in the folder above. Burning is not in this version yet: K3b, Brasero or Xfburn will burn the ISO."
                               IsVisible="{Binding !IsWorking}"
                               AutomationProperties.AutomationId="WhatTheButtonsMean" />

                    <!-- The sentence under the list counts what is unticked.
                         This is the connection to it, at the exact moment the
                         question is asked, without a dialog interrupting
                         every build. It stays while the work runs, because it
                         is just as true then. -->
                    <TextBlock Classes="Aside"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding WhatBuildingGoesWithout}"
                               IsVisible="{Binding WhatBuildingGoesWithout, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="WhatBuildingGoesWithout" />

                    <!-- What the image had to say that stopped nothing. -->
                    <TextBlock Classes="Aside"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding AboutTheImage}"
                               IsVisible="{Binding AboutTheImage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="AboutTheImage" />

                    <!-- Gone when there is nothing to say. An empty line still
                         takes the height of a line. -->
                    <!-- The reason is the hover, and the numbers are drawn. A
                         refusal has always carried a headline, a sentence
                         saying why, and its figures. The sentence wants more
                         room than this line has, which is the whole reason
                         the figures exist, so the figures go on the window
                         and the sentence goes where hovering finds it. -->
                    <TextBlock Foreground="{DynamicResource RefusalInk}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding WhyNot.Headline}"
                               ToolTip.Tip="{Binding WhyNot.Because}"
                               IsVisible="{Binding WhyNot, Converter={x:Static ObjectConverters.IsNotNull}}"
                               AutomationProperties.AutomationId="WhyNot" />

                    <!-- What to do about it, when the window can do it.
                         Quiet rather than a button: the red line above is the
                         thing to read, and this is the thing to press once it
                         has been read. -->
                    <Button Content="{Binding WhatTheWayOutIsCalled}"
                            Theme="{StaticResource Quietly}"
                            Margin="0,4,0,0"
                            IsEnabled="{Binding NothingIsRunning}"
                            IsVisible="{Binding WhatTheWayOutIsCalled, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Click="TakeTheWayOut"
                            AutomationProperties.AutomationId="TheWayOut" />

                    <ItemsControl Margin="0,4,0,0"
                                  ItemsSource="{Binding WhyNot.Figures}"
                                  IsVisible="{Binding !!WhyNot.Figures.Count}"
                                  AutomationProperties.AutomationId="WhyNotFigures">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Wrapped, because two figures fit on this
                                     line and a third would be drawn off the
                                     end of a window nobody can widen. -->
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:Figure">
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <TextBlock Classes="Aside"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Label}"
                                               AutomationProperties.Name="{Binding Label}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               Foreground="{DynamicResource Ink}"
                                               Text="{Binding Value}"
                                               AutomationProperties.Name="{Binding Value}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Foreground="{DynamicResource WorryInk}"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding Worry.Headline}"
                               ToolTip.Tip="{Binding Worry.Because}"
                               IsVisible="{Binding Worry, Converter={x:Static ObjectConverters.IsNotNull}}"
                               AutomationProperties.AutomationId="Worry" />

                    <!-- A worry carries figures too, and the one that has
                         them is the one that needs them most: it shows the
                         name you typed beside the name the disc will really
                         show, which is what makes the decision obvious. -->
                    <ItemsControl Margin="0,4,0,0"
                                  ItemsSource="{Binding Worry.Figures}"
                                  IsVisible="{Binding !!Worry.Figures.Count}"
                                  AutomationProperties.AutomationId="WorryFigures">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:Figure">
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <TextBlock Classes="Aside"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Label}"
                                               AutomationProperties.Name="{Binding Label}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="NoWrap"
                                               Foreground="{DynamicResource Ink}"
                                               Text="{Binding Value}"
                                               AutomationProperties.Name="{Binding Value}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What to do about the worry: "Rename the disc", beside
                         the name the disc will really show. -->
                    <Button Content="{Binding WhatTheWorrysWayOutIsCalled}"
                            Theme="{StaticResource Quietly}"
                            Margin="0,4,0,0"
                            IsEnabled="{Binding NothingIsRunning}"
                            IsVisible="{Binding WhatTheWorrysWayOutIsCalled, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Click="TakeTheWorrysWayOut"
                            AutomationProperties.AutomationId="TheWorrysWayOut" />
                </StackPanel>

                <!-- Erase a disc and Burn to a disc stand to the left of this
                     in the Windows window. They come with the recorder. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Build it"
                            Theme="{StaticResource TheButton}"
                            IsEnabled="{Binding CanMakeIt}"
                            Click="MakeTheDisc"
                            AutomationProperties.AutomationId="MakeTheDisc" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
