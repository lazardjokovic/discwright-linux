<!--
    Shown when the folder somebody picked held more than the game.

    It exists because the alternative was silence: the recogniser takes the
    installer and its parts, and a patch and a README sitting beside them were
    dropped with no sign that anything had gone. Losing a file quietly is the
    worst way to lose it.

    WhatElseIsInThere.xaml in the Windows app, over WhatElseWasInThere, which
    is everything this question knows with no window in it. What is here is
    the arrangement and three presses.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:screen="using:DiscWright.ViewModels"
        x:Class="DiscWright.LinuxApp.WhatElseIsInThere"
        x:DataType="screen:WhatElseWasInThere"
        Title="There is more in that folder"
        Icon="/DiscWright.ico"
        Height="460" Width="700"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="WhatElseIsInThere">

    <Grid Margin="24,20,24,18" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Classes="Title"
                       FontSize="17"
                       Text="{Binding Headline}"
                       AutomationProperties.AutomationId="Headline" />
            <TextBlock Classes="Aside"
                       Margin="0,4,0,0"
                       Text="The game itself is already going on. These were beside it. Anything left unticked stays off the disc." />

            <!-- Said once, above the rows, only when patches are among the
                 files: what a patch is, and what this disc's installer
                 already carries, so the ticks' defaults have their reason
                 in sight. The owner's ask on 2026-11-09. -->
            <TextBlock Classes="Aside"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding AboutPatches}"
                       IsVisible="{Binding AboutPatches, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       AutomationProperties.AutomationId="AboutPatches" />

            <!-- For the person keeping everything: the patch defaults
                 untick what the installer covers, and an archive disc
                 wants it anyway. Grey when there is nothing left to
                 tick. -->
            <Button Content="Tick them all"
                    Theme="{StaticResource Quietly}"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding CanTickThemAll}"
                    Click="TickThemAll"
                    AutomationProperties.AutomationId="TickThemAll" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Edge}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,8">
                <ItemsControl ItemsSource="{Binding Files}" AutomationProperties.AutomationId="Files">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="screen:OneThingLeftBehind">
                            <Grid Margin="8,7" ColumnDefinitions="*,Auto,Auto">

                                <!-- The reason line sits beside the box
                                     rather than inside it, where on Windows
                                     it was measured with no width to speak
                                     of and "so it adds nothing to this disc"
                                     was clipped to "so it adds", which reads
                                     as the exact opposite of what it says. -->
                                <StackPanel Grid.Column="0">
                                    <CheckBox Margin="0"
                                              IsChecked="{Binding Wanted}"
                                              AutomationProperties.AutomationId="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                    <TextBlock Classes="Aside"
                                               TextWrapping="Wrap"
                                               Margin="24,2,0,0"
                                               Text="{Binding Explains}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Classes="Aside"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           Margin="12,0,14,0"
                                           Text="{Binding Size}" />

                                <!-- The guess is a starting point, not a
                                     ruling: an .exe beside a game is usually
                                     something that installs onto it, but a
                                     standalone tool is not. -->
                                <ComboBox Grid.Column="2"
                                          Width="210"
                                          VerticalAlignment="Center"
                                          SelectedIndex="{Binding Treatment}"
                                          IsEnabled="{Binding Wanted}"
                                          AutomationProperties.AutomationId="{Binding WhatToDoWithIt}">
                                    <!-- In the order of WhatBecomesOfIt, which
                                         the selected index is cast to. -->
                                    <ComboBoxItem Content="The game's manual" />
                                    <ComboBoxItem Content="One of the game's extras" />
                                    <ComboBoxItem Content="Attach as an add-on" />
                                    <ComboBoxItem Content="Beside the installer, no button" />
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <!-- Only when several folders are being added together, so a
                 compilation is asked once rather than once a game, which
                 xniwo met adding nine (discwright#98). -->
            <CheckBox Margin="0,12,0,0"
                      IsChecked="{Binding TheSameForTheRest}"
                      IsVisible="{Binding TheSameForTheRestSays, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      AutomationProperties.AutomationId="TheSameForTheRest">
                <TextBlock Text="{Binding TheSameForTheRestSays}" />
            </CheckBox>

            <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Content="None of them"
                        Theme="{StaticResource Ordinary}"
                        Click="NoneOfThem"
                        AutomationProperties.AutomationId="NoneOfThem" />

                <!-- Grey with nothing ticked: it would put nothing on, which
                     is the other button's job, said honestly instead of a
                     press that does the opposite of its words. -->
                <Button Grid.Column="2"
                        Content="Put these on too"
                        Theme="{StaticResource TheButton}"
                        Click="TakeThem"
                        IsDefault="True"
                        IsEnabled="{Binding AnyWanted}"
                        AutomationProperties.AutomationId="TakeThem" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
