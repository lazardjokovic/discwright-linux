<!--
    Something said plainly, with one way to answer it: a refusal, or the
    address of a page no browser would open.

    On Windows these are message boxes, seven of them, and Avalonia has no
    message box. So this is a window of our own, laid out like WorthAsking
    beside it. It is also the first time a refusal in a box can be read by a
    test: a Windows message box is a pane with no patterns on it.

    The headline and what follows it are two pieces of text and not one, so
    the headline can be the heavier.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:DiscWright.LinuxApp"
        xmlns:core="using:DiscWright.Core"
        x:Class="DiscWright.LinuxApp.SayingSo"
        x:DataType="app:SayingSo"
        Title="DiscWright"
        Icon="/DiscWright.ico"
        SizeToContent="Height"
        Width="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="SayingSo">

    <StackPanel Margin="24,20,24,18">
        <TextBlock Classes="Title"
                   FontSize="17"
                   Text="{Binding Headline}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Headline" />

        <!-- A refusal that is all headline has nothing to put here, and a
             gap where a sentence should be reads as something missing. -->
        <SelectableTextBlock Margin="0,8,0,0"
                             Text="{Binding Because}"
                             TextWrapping="Wrap"
                             SelectionBrush="{DynamicResource Accent}"
                             IsVisible="{Binding HasMoreToSay}"
                             AutomationProperties.AutomationId="Because" />

        <!-- A refusal's figures, one to a line, which a Windows message box
             has no place for and this box left out for the same reason until
             2026-11-16. On Linux they are not decoration: the refusal for a
             missing xorriso carries the line to type for each kind of system
             as its figures, and without them it said "install it" and not
             how.

             One to a line and not wrapped side by side as on the main
             window's bottom line, because these are sentences to copy and
             not numbers to glance at. The value can be selected, so it can
             be copied into a terminal. -->
        <ItemsControl Margin="0,12,0,0"
                      ItemsSource="{Binding Figures}"
                      IsVisible="{Binding HasFigures}"
                      AutomationProperties.AutomationId="Figures">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:Figure">
                    <Grid ColumnDefinitions="170,*" Margin="0,3,0,0">
                        <TextBlock Classes="Aside"
                                   VerticalAlignment="Top"
                                   TextWrapping="Wrap"
                                   Text="{Binding Label}"
                                   AutomationProperties.Name="{Binding Label}" />
                        <SelectableTextBlock Grid.Column="1"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource Ink}"
                                             SelectionBrush="{DynamicResource Accent}"
                                             Text="{Binding Value}"
                                             AutomationProperties.Name="{Binding Value}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,22,0,0" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1"
                    Content="OK"
                    Theme="{StaticResource TheButton}"
                    MinWidth="88"
                    Click="Understood"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.AutomationId="Understood" />
        </Grid>
    </StackPanel>
</Window>
