<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The answers a Linux machine gives where Platform, Imaging and Burning give
    Windows ones. It targets net10.0 and references Core alone, so it is as far
    from the window as they are, and nothing in it may be a Windows call.

    So far: what a Windows installer calls itself, the image made with
    xorriso, and pictures. More arrive as each port gets its Linux side.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DiscWright.Core\DiscWright.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pictures. System.Drawing has been Windows only since .NET 7, and Skia
         is what the Linux window will be drawn with as well, so this is one
         dependency for both jobs. The second package is Skia itself built for
         Linux with nothing else needed from the system, which is what lets the
         app run on a machine that has never had it installed. -->
    <PackageReference Include="SkiaSharp" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
